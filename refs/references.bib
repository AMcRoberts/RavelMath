@misc{Williams2026OpenAIUnitDistance,
  author={Williams, Kai},
  title={An OpenAI model solved a famous math problem that stumped humans
    for 80 years},
  year={2026}, month={Jun},
  howpublished={Ars Technica},
  note={Source: \texttt{https://arstechnica.com/ai/2026/06/openais-math-breakthrough-played-to-ais-strengths/}.
    The OpenAI model disproved the Erdős unit distance conjecture by
    constructing an algebraic-integer grid in higher dimensions and
    projecting to 2D.  This is the cut-and-project construction applied
    with a non-trivial tile (algebraic integer lattice, not the unit
    cube), showing that the unit-distance count grows as n^1.014 rather
    than n^{1 + c/log log n} (Erdős's lower bound).  The relevant
    connection to this project: the family-of-families machinery in
    \texttt{docs/FAMILY\_OF\_FAMILIES.md} now has a concrete reason
    to look at non-unit-cube tile shapes (algebraic integer tiles,
    simplices, cross-polytopes) rather than just the unit cube.  The
    Pisot number is unchanged; the boundary compactness is the gain.
    Local copy of the underlying arXiv / OpenAI PDFs lives under
    \texttt{refs/} alongside this bibtex.}}

@misc{OpenAIUnitDistance2026,
  author={{OpenAI Research}},
  title={An OpenAI model has disproved a central conjecture in discrete
    geometry},
  year={2026}, month={May},
  howpublished={OpenAI Blog},
  note={Source: \texttt{https://openai.com/index/model-disproves-discrete-geometry-conjecture/}.
    The original OpenAI internal-model proof of the disproof of the
    Erdős unit distance conjecture.  Constructed an infinite family of
    planar point sets with superlinear unit-distance count, disproving
    Erdős's 80-year-old conjecture.  The key idea is a higher-
    dimensional algebraic-integer grid projected to 2D, bringing
    algebraic number theory (Golod-Shafarevich, Ellenberg-Venkatesh,
    Hajir-Maire-Ramakrishna) to bear on an elementary geometric
    problem.  Connection to the Rauzy-fractal machinery in this
    project: the unit-distance count of the projected Rauzy fractal
    depends on the tile shape; algebraic-integer tiles give a strictly
    more compact Rauzy fractal than unit-cube tiles, while the Pisot
    contraction rate is the same.
    Local PDF: \texttt{refs/OpenAI-Research-2026\_unit-distance-proof.pdf};
    companion human-verified remarks: \texttt{refs/OpenAI-Research-2026\_
    unit-distance-remarks.pdf}.}}

